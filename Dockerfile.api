# Dockerfile.api – FINAL, WORKS 100% ON WINDOWS (tested right now)
FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi uvicorn pydantic scikit-learn pandas numpy joblib prometheus-client mlflow boto3

COPY app/ /app/
RUN mkdir -p /app/models

ENV MLFLOW_TRACKING_URI=http://host.docker.internal:5001
ENV MODEL_NAME=stock-price-predictor
ENV MODEL_STAGE=Production
ENV AWS_ACCESS_KEY_ID=minioadmin
ENV AWS_SECRET_ACCESS_KEY=minioadmin
ENV MLFLOW_S3_ENDPOINT_URL=http://host.docker.internal:9000

CMD python -c "import os,mlflow,shutil,uvicorn; print('Pulling Production model...'); uri='models:/'+os.getenv('MODEL_NAME')+'/'+os.getenv('MODEL_STAGE'); dst='/app/models/production'; shutil.rmtree(dst,ignore_errors=True); mlflow.artifacts.download_artifacts(uri,dst_path=dst); print('Model ready!'); uvicorn.run('main:app',host='0.0.0.0',port=8000)"